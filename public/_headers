# Security headers for every static response. The Astro Cloudflare adapter
# merges its own /_astro/* Cache-Control block into this file at build time.
# No script-src CSP on purpose: the page embeds YouTube iframes and Turnstile.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
