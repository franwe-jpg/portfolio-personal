---
import { profile, PROFILE_COPY } from '../data/profile';
import { LANG_STORAGE_KEY, pathForLang, SPANISH_COUNTRIES, type Lang } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;

// `Astro.site` comes from `site` in astro.config.mjs; it falls back to the
// request URL so the tags stay valid before the domain is configured.
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base).href;
const esHref = new URL(pathForLang('es'), base).href;
const enHref = new URL(pathForLang('en'), base).href;
// Static 1200×630 card and the icon set, generated by scripts/brand-assets.mjs.
const ogImage = new URL('/og.png', base).href;

/** Structured data for search engines: who this site is about. */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: PROFILE_COPY[lang].role,
  url: canonical,
  image: ogImage,
  email: `mailto:${profile.links.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Trelew', addressRegion: 'Chubut', addressCountry: 'AR' },
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.instagram],
};

// Inlined into the language script below so the country list has exactly one
// source of truth: the constant in src/i18n/config.ts.
const spanishCountries = Array.from(SPANISH_COUNTRIES);
/** Marks the automatic redirect as already attempted for this session. */
const langAutoKey = 'lang-auto';
/** Key-cap "FS" mark with the green dot, same as the prototype. */
const FAVICON =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2310120d'/%3E%3Ctext x='31' y='42' font-family='Instrument Sans,Inter,Arial,sans-serif' font-weight='700' font-size='30' fill='%23fff' text-anchor='middle'%3EFS%3C/text%3E%3Ccircle cx='52' cy='12' r='6' fill='%231fbf75'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    {/* Paper while the gate shows; src/scripts/gate.ts switches it to the dark stage on enter. */}
    <meta name="theme-color" content="#0e1013" />
    {/* The .ico is the fallback; browsers that understand SVG icons prefer the last one. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={FAVICON} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/*
      Resolves the language before the first paint: inline and out of the
      bundle graph, so a visitor who landed on the wrong route is moved before
      the page is worth reading. `define:vars` carries the constants in, which is why the
      country list is not duplicated here. Kept in sync with the
      LANG_STORAGE_KEY constant in src/i18n/config.ts.
    */}
    <script define:vars={{ langKey: LANG_STORAGE_KEY, langAutoKey, spanishCountries }}>
      (function () {
        var current = document.documentElement.lang === 'en' ? 'en' : 'es';

        // An explicit choice always wins, and never consumes the session flag.
        var stored = null;
        try {
          stored = localStorage.getItem(langKey);
        } catch (error) {
          /* Privacy modes throw; treat it as no choice made. */
        }
        if (stored === 'es' || stored === 'en') {
          if (stored !== current) location.replace(stored === 'en' ? '/en/' : '/');
          return;
        }

        // The guess only ever runs on the default route. /en/ is an address
        // someone typed, shared or was sent: guessing there would drag a
        // deliberately English link back to Spanish.
        if (current !== 'es') return;

        // At most one automatic redirect per session, so the two routes can
        // never bounce a visitor back and forth.
        try {
          if (sessionStorage.getItem(langAutoKey)) return;
          sessionStorage.setItem(langAutoKey, '1');
        } catch (error) {
          /* Without sessionStorage the guard is gone, so do not redirect. */
          return;
        }

        // A Spanish-speaking browser stays on Spanish whatever the IP says:
        // plenty of Argentines read this page from abroad.
        var nav = (navigator.language || '').toLowerCase();
        if (nav.indexOf('es') === 0) return;

        fetch('/api/geo')
          .then(function (response) {
            return response.json();
          })
          .then(function (data) {
            var country =
              data && typeof data.country === 'string' ? data.country.toUpperCase() : null;
            if (!country) return;
            if (spanishCountries.indexOf(country) === -1) location.replace('/en/');
          })
          .catch(function () {
            /* Silent: the visitor simply keeps the page they were served. */
          });
      })();
    </script>

    {/* The chat panel loads the Turnstile widget from here; warm the connection. */}
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={UI[lang].ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={UI[lang].ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={UI[lang].ogImageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />
  </body>
</html>
