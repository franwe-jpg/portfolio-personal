---
import { profile } from '../data/profile';
import { SUGGESTIONS } from '../data/messages';
import { MAX_QUESTION_CHARS } from '../lib/persona';
import { otherLang, pathForLang, type Lang } from '../i18n/config';
import { UI } from '../i18n/ui';
import Avatar from './Avatar.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
// A real href, so the switch works without JS and both routes stay crawlable.
const otherHref = pathForLang(otherLang(lang));
// Rendered twice: the second, inert copy makes the marquee loop seamless.
const suggestions = SUGGESTIONS[lang];
const marqueeCopies = [false, true];
---

<div class="screen" id="chatScreen">
  <div class="chat-header">
    <span class="back"
      ><svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
      ></span
    >
    <button
      type="button"
      class="contact-btn"
      id="contactBtn"
      aria-label={t.openProfileLabel(profile.name)}
      aria-controls="profileScreen"
      aria-expanded="false"
    >
      <Avatar lang={lang} />
      <span class="who">
        <span class="name">{profile.name}</span>
        <span class="status" id="status">{t.statusOnline}</span>
      </span>
    </button>
    <div class="hdr-actions">
      <button
        type="button"
        class="hdr-btn"
        id="hdrMenuBtn"
        aria-label={t.menuLabel}
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="hdrMenu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><circle cx="12" cy="5" r="1.9"></circle><circle cx="12" cy="12" r="1.9"></circle><circle
            cx="12"
            cy="19"
            r="1.9"></circle></svg
        >
      </button>

      <div class="hdr-menu" id="hdrMenu" role="menu" aria-labelledby="hdrMenuBtn" hidden>
        <button type="button" role="menuitem" id="themeMenuItem">
          <span class="theme-icon" aria-hidden="true"></span>
          <span class="theme-label">{t.themeDark}</span>
        </button>
        <a href={otherHref} role="menuitem" id="langMenuItem" data-lang={otherLang(lang)}>
          <span aria-hidden="true"
            ><svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path
                d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"></path></svg
          ></span>
          <span>{t.langMenuItem}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="chat-body" id="body">
    <div class="chat-list" id="list">
      <div class="chip lock">{t.disclaimer}</div>
      <div class="chip">{t.todayChip}</div>
      <!-- Live chat bubbles; the scripted render never touches them. -->
      <div class="live-list" id="liveList" aria-live="polite"></div>
    </div>
    <div class="hint" id="hint" aria-hidden="true">
      <div class="hint-card">
        <span class="hint-tap"></span>
        <span class="hint-text hint-text-touch">{t.tapHint}</span>
        <span class="hint-text hint-text-pointer">{t.clickHint}</span>
      </div>
    </div>
  </div>

  <!-- Shown once the scripted conversation ends; gone after the first message. -->
  <button type="button" class="open-prompt" id="openPrompt" hidden>
    <span class="open-prompt-title">{t.openPromptTitle}</span>
    <span class="open-prompt-text">{t.openPromptText}</span>
    <span class="open-prompt-arrow" aria-hidden="true">👇</span>
  </button>

  <!-- Suggested questions, shown above the keyboard once the live chat opens. -->
  <div class="suggestions" id="suggestions" role="group" aria-label={t.suggestionsLabel} hidden>
    <div class="suggestions-track" id="suggestionsTrack">
      {
        marqueeCopies.map((inert) =>
          suggestions.map((question, index) => (
            <button
              type="button"
              class="suggestion"
              data-suggestion={index}
              aria-hidden={inert ? 'true' : undefined}
              tabindex={inert ? -1 : undefined}
            >
              {question}
            </button>
          )),
        )
      }
    </div>
  </div>

  <form class="composer" id="composer" autocomplete="off">
    <label class="sr-only" for="composerInput">{t.composerLabel(profile.name)}</label>

    <!-- The <emoji-picker> is injected here only on the first click. -->
    <div class="emoji-popover" id="emojiPopover" hidden></div>

    <div class="input">
      <button
        type="button"
        class="emoji-btn"
        id="emojiBtn"
        aria-label={t.emojiButtonLabel}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="emojiPopover"
        disabled
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="9"></circle><path
            d="M8.5 14.5a4.5 4.5 0 0 0 7 0"
            stroke-linecap="round"></path><circle cx="9" cy="10" r="1.1" fill="currentColor"></circle><circle
            cx="15"
            cy="10"
            r="1.1"
            fill="currentColor"></circle></svg
        >
      </button>
      <input
        type="text"
        id="composerInput"
        name="question"
        maxlength={MAX_QUESTION_CHARS}
        disabled
      />
    </div>
    <button type="submit" class="send" id="composerSend" aria-label={t.sendButtonLabel} disabled>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"
        ><path d="M2.5 21.5 22 12 2.5 2.5 2.5 10l14 2-14 2z"></path></svg
      >
    </button>
  </form>
</div>
