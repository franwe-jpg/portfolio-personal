---
import { profile } from '../data/profile';
import type { UiCopy } from '../i18n/ui';
import Icon from './Icon.astro';
import Ticket from './Ticket.astro';

/** Landing page: matrix rain behind the hero and the two calls to action. */
interface Props {
  t: UiCopy;
}

const { t } = Astro.props;

/** Outline-only social icons (24px box, stroke drawn in currentColor). */
const SOCIAL = [
  {
    href: profile.links.instagram,
    label: t.inicio.social.instagram,
    external: true,
    shapes: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>',
  },
  {
    href: profile.links.linkedin,
    label: t.inicio.social.linkedin,
    external: true,
    shapes: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V16M8 7.5h.01M11.5 16v-5.5M11.5 13a2.5 2.5 0 0 1 5 0V16"/>',
  },
  {
    href: `mailto:${profile.links.email}`,
    label: t.inicio.social.email,
    external: false,
    shapes: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/>',
  },
];
---

<section class="page page-inicio" data-page="inicio" id="inicio" aria-label={t.inicio.label}>
  <canvas id="rain" aria-hidden="true"></canvas>
  <div class="rain-shade" aria-hidden="true"></div>
  <div class="hero">
    <span class="hero-eyebrow" data-depth="-0.3">{t.inicio.eyebrow}</span>
    <h1 class="hero-title" id="heroTitle" data-glitch data-depth="0.5" tabindex="-1">
      <span class="l1">{t.inicio.titleLine1}</span><span class="l2">{t.inicio.titleLine2}</span>
    </h1>
    <p class="hero-desc" data-depth="0.3">{t.inicio.description}</p>
    <div class="hero-actions" data-depth="0.6">
      <button class="pill-btn pill-world" type="button" data-go="mundo">
        <span class="ws-mini" aria-hidden="true"></span>{t.inicio.explore}
        <Icon name="arrow-ne" size={16} />
      </button>
      <span class="tk-host tk-host--flush">
        <button class="pill-btn" type="button" data-go="proyectos">
          {t.inicio.projects}
          <Icon name="arrow-ne" size={14} />
        </button>
        <Ticket id="inicio" dir="right" />
      </span>
    </div>
  </div>
  <nav class="inicio-social" aria-label={t.inicio.social.label}>
    {SOCIAL.map((s) => (
      <a
        href={s.href}
        aria-label={s.label}
        title={s.label}
        {...(s.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.shapes} />
      </a>
    ))}
  </nav>
</section>
