const copy = COPY[lang];

/** mulberry32: a tiny seeded PRNG so the nonsense is identical on every build. */
function mulberry32(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(lang === 'es' ? 20261107 : 20261108);
const pick = <T,>(list: readonly T[]): T => list[Math.floor(rand() * list.length)];
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

function sentence(): string {
  const { subjects, verbs, objects, connectors, adjectives } = copy.pools;
  const shapes = [
    () => `${capitalize(pick(connectors))}, ${pick(subjects)} ${pick(verbs)} ${pick(objects)}`,
    () => `${capitalize(pick(subjects))} ${pick(verbs)} ${pick(objects)}, ${pick(connectors)}`,
    () => `${capitalize(pick(subjects))}, ${pick(connectors)}, ${pick(verbs)} ${pick(objects)} ${lang === 'es' ? 'de forma' : 'in a'} ${pick(adjectives)} ${lang === 'es' ? 'y' : 'and'} ${pick(adjectives)} ${lang === 'es' ? '' : 'manner'}`,
    () => `${capitalize(pick(connectors))}, ${pick(subjects)} ${pick(verbs)} ${pick(objects)} ${lang === 'es' ? 'y' : 'and'} ${pick(objects)}`,
  ];
  return `${pick(shapes)().replace(/\s+/g, ' ').trim()}.`;
}

const ARTICLES = 40;
/** Every article after the first carries the bold notice right under its heading. */
const NOTICE_FROM = 2;
const articles = Array.from({ length: ARTICLES }, (_, i) => {
  const paragraphs = Array.from({ length: 1 + Math.floor(rand() * 2) }, () =>
    Array.from({ length: 2 + Math.floor(rand() * 3) }, sentence).join(' '),
  );
  return { n: i + 1, title: pick(copy.pools.titles), paragraphs };
});
---

<main class="terms">
  <header>
    <h1>{copy.title}</h1>
    <p class="subtitle">{copy.subtitle}</p>
  </header>
  <a class="pill-btn" href={copy.home}>{copy.back}</a>
  <p class="lead"><strong>{copy.opening}</strong></p>
  {
    articles.map((a) => (
      <section>
        <h2>
          <span class="num">{copy.article} {a.n}</span> — {a.title}
        </h2>
        {a.n >= NOTICE_FROM && (
          <p class="notice">
            <strong>{copy.notice}</strong>
          </p>
        )}
        {a.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </section>
    ))
  }
  <p class="lead closing"><strong>{copy.closing}</strong></p>
  <footer>
    <a class="pill-btn" href={copy.home}>{copy.back}</a>
    <p class="credit">{copy.credit}</p>
  </footer>
</main>

<style>
  :global(html) {
    background: #e7eaee;
  }
  :global(body) {
    margin: 0;
    color: #15181d;
    background: #e7eaee;
    font: 400 16px/1.6 'Instrument Sans', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .terms {
    max-width: 72ch;
    margin: 0 auto;
    padding: clamp(32px, 8vh, 72px) 16px 64px;
  }
  header {
    margin-bottom: 32px;
    border-bottom: 1px solid rgba(21, 24, 29, 0.14);
    padding-bottom: 20px;
  }
  h1 {
    margin: 0 0 8px;
    font-size: clamp(24px, 4vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .subtitle {
    margin: 0;
    color: #5b6370;
    font: 400 12px/1.5 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .lead {
    font-size: 18px;
    line-height: 1.5;
  }
  .closing {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(21, 24, 29, 0.14);
  }
  section {
    margin-top: 28px;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 17px;
    line-height: 1.3;
  }
  .num {
    font: 500 12px/1 'JetBrains Mono', ui-monospace, monospace;
    color: #17955b;
    letter-spacing: 0.06em;
  }
  p {
    margin: 0 0 12px;
    text-align: justify;
    hyphens: auto;
  }
  footer {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid rgba(21, 24, 29, 0.14);
    display: grid;
    gap: 12px;
  }
  /* Same pill as the site's paper pages (.pill-btn in pages.css), self-contained here. */
  .pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 24px;
    margin: 0 0 28px;
    border-radius: 999px;
    border: 1px solid #15181d;
    background: transparent;
    color: #15181d;
    font: 500 16px 'Instrument Sans', system-ui, sans-serif;
    text-decoration: none;
    justify-self: start;
    transition: background-color 0.18s, color 0.18s, transform 0.18s, box-shadow 0.18s;
  }
  .pill-btn:hover {
    background: #15181d;
    color: #f3f5f7;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -16px rgba(0, 0, 0, 0.7);
  }
  footer .pill-btn {
    margin: 0;
  }
  .notice {
    font-size: 17px;
    text-align: left;
  }
  @media (prefers-reduced-motion: reduce) {
    .pill-btn {
      transition: none;
    }
    .pill-btn:hover {
      transform: none;
    }
  }
  .credit {
    margin: 0;
    color: #5b6370;
    font-size: 13px;
    text-align: left;
  }
  :global(:focus-visible) {
    outline: 2px solid #1fbf75;
    outline-offset: 3px;
  }
</style>
