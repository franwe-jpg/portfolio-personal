---
import type { Lang } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
  id: string;
  class?: string;
}

const { lang, id, class: className } = Astro.props;
const classes = ['view-toggle-btn', className].filter(Boolean).join(' ');
---

<button type="button" class={classes} id={id}>
  <span class="vt-icon"
    ><svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      ><rect x="3" y="3" width="7" height="7" rx="1.3"></rect><rect
        x="14"
        y="3"
        width="7"
        height="7"
        rx="1.3"></rect><rect x="3" y="14" width="7" height="7" rx="1.3"></rect><rect
        x="14"
        y="14"
        width="7"
        height="7"
        rx="1.3"></rect></svg
    ></span
  >
  <span class="vt-label">{UI[lang].viewProjects}</span>
</button>
