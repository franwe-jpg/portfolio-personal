---
import { pathForLang, type Lang } from '../i18n/config';
import type { UiCopy } from '../i18n/ui';
import Icon from './Icon.astro';

/** Fixed top HUD: back arrow (src/scripts/back.ts), wordmark, the page navigation and the language flags. */
interface Props {
  lang: Lang;
  t: UiCopy;
}

const { lang, t } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
/** Generated by scripts/flag-assets.mjs. */
const FLAGS: Record<Lang, string> = { es: '/banderas/ar.png', en: '/banderas/gb.png' };
---

<header class="hud-top">
  <div class="brand-row">
    <button class="back-gate" id="backGate" type="button" title={t.header.back.gate} aria-label={t.header.back.gate}>
      <Icon name="back" size={16} />
    </button>
    <a class="brand" href="#inicio" data-go="inicio">
      <span class="brand-name" id="brandName" aria-hidden="true">{t.header.brand}</span>
      <span class="sr-only">{t.header.brandSr}</span>
    </a>
  </div>
  <nav class="nav" aria-label={t.header.navLabel}>
    <a href="#mundo" data-go="mundo" data-scr>{t.header.nav.mundo}</a>
    <a href="#proyectos" data-go="proyectos" data-scr>{t.header.nav.proyectos}</a>
    <a href="#sobre" data-go="sobre" data-scr>{t.header.nav.sobre}</a>
    {/* Round flags, no frame (Argentina for Spanish, the UK for English): the current language in front, the other
        one tucked behind it and peeking out; the whole stack links to the other version. src/scripts/i18n.ts
        persists the choice so the automatic redirect never undoes it. */}
    <a class="lang-switch" id="langSwitch" href={pathForLang(other)} hreflang={other} lang={other} aria-label={t.header.lang.sr} title={t.header.lang.sr}>
      <img class="flag flag-behind" src={FLAGS[other]} width="22" height="22" alt="" />
      <img class="flag flag-front" src={FLAGS[lang]} width="22" height="22" alt="" />
    </a>
  </nav>
</header>
