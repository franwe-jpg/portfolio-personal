---
import { projectsFor } from '../data/projects';
import type { Lang } from '../i18n/config';
import { UI } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';
import Avatar from './Avatar.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = projectsFor(lang);
---

<div class="screen" id="projectsScreen">
  <div class="chat-header">
    <Avatar lang={lang} />
    <div class="who">
      <div class="name">{UI[lang].projectsTitle}</div>
    </div>
  </div>

  <div class="proj-body">
    <div class="proj-list" id="projList">
      {projects.map((project) => <ProjectCard lang={lang} project={project} />)}
    </div>
  </div>
</div>
