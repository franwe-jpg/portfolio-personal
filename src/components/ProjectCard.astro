---
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/config';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const t = UI[lang];
const hasCarousel = project.media.length > 1;
---

<article class="proj-card">
  <div class="proj-carousel">
    <div class="proj-track">
      {
        project.media.map((item) =>
          item.kind === 'video' ? (
            <iframe
              class="proj-video"
              src={`https://www.youtube-nocookie.com/embed/${item.youtubeId}`}
              title={item.alt}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          ) : (
            <img src={item.src} alt={item.alt} loading="lazy" />
          ),
        )
      }
    </div>
    {
      hasCarousel && (
        <>
          <button type="button" class="proj-arrow prev" aria-label={t.previousImage}>
            ‹
          </button>
          <button type="button" class="proj-arrow next" aria-label={t.nextImage}>
            ›
          </button>
          <div class="proj-dots">
            {project.media.map((_, index) => (
              <span class={index === 0 ? 'active' : undefined} />
            ))}
          </div>
        </>
      )
    }
  </div>
  {project.badge && <p class="proj-badge">{project.badge}</p>}
  <h3 class="proj-title">{project.title}</h3>
  <p class="proj-desc">{project.description}</p>
  {
    project.links.length > 0 && (
      <div class="proj-links">
        {project.links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener">
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</article>
