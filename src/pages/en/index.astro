---
import App from '../../components/App.astro';
import { PROFILE_COPY } from '../../data/profile';
import Layout from '../../layouts/Layout.astro';
import { UI } from '../../i18n/ui';

const lang = 'en';
const copy = PROFILE_COPY[lang];
---

<Layout lang={lang} title={copy.tagline} description={UI[lang].metaDescription(copy.role)}>
  <App lang={lang} />
</Layout>
